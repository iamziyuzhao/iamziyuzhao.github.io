---
import Base from "../../layouts/Base.astro";
import Comments from "../../components/Comments.astro";
import { formatDate } from "../../data/format";
import { caseStudy } from "../../data/posts";
import body from "../../data/case-study/en.html?raw";

const { title, description, date, readMins, category } = caseStudy;

// Wide code blocks, tables and diagrams scroll sideways on phones; make each
// scroller keyboard-focusable, and wrap tables so they keep table semantics.
const html = body
  .replaceAll("<pre><code", '<pre tabindex="0"><code')
  .replaceAll("<table>", '<div class="table-scroll" tabindex="0" role="region" aria-label="Table"><table>')
  .replaceAll("</table>", "</table></div>")
  .replaceAll('<div class="mermaid-box">', '<div class="mermaid-box" tabindex="0" role="region" aria-label="Diagram">');
---

<Base title={`${title} | Ziyu Zhao`} description={description}>
  <article class="prose post">
    <h1>{title}</h1>
    <div class="post-meta">
      <time datetime={date}>{formatDate(date)}</time> · {readMins} min read · {category}
    </div>

    <div class="cs" set:html={html}></div>

    <Comments />
  </article>

  <script is:inline type="module">
    import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11.17.2/dist/mermaid.esm.min.mjs";
    mermaid.initialize({
      startOnLoad: false,
      theme: "neutral",
      securityLevel: "loose",
      fontFamily: '"Lato", -apple-system, "Segoe UI", Helvetica, Arial, sans-serif',
      flowchart: { htmlLabels: true, curve: "basis" },
    });
    // size the labels with Lato, not the fallback font, or they get clipped
    await document.fonts.ready;
    try {
      await mermaid.run({ querySelector: ".cs pre.mermaid", suppressErrors: true });
    } catch {
      /* leave any un-rendered diagram as its source text */
    }
    // Fit each diagram to the column, but never below 75% of its natural size
    // (about 12px labels); wider ones scroll inside .mermaid-box instead.
    for (const svg of document.querySelectorAll(".cs pre.mermaid > svg")) {
      svg.style.minWidth = `${svg.viewBox.baseVal.width * 0.75}px`;
    }
  </script>
</Base>

<style is:global>
  /* Case study body — inherits the site's .prose styles; only the custom
     classes from the source doc are themed here. */
  .cs {
    /* the source sets each system's dot colour inline via these names */
    --harbor: #2f6f9f;
    --verif: #3f7d55;
    --slime: #b4551f;
  }
  /* "Contents" is an h2 for the outline, sized like the h3s below it */
  .cs > h2:first-child {
    font-size: 1.15rem;
    margin-top: 1.75rem;
  }
  .cs ol.toc {
    font-size: 0.95em;
  }
  .cs .sysdot {
    display: inline-block;
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    margin-right: 0.4em;
    vertical-align: 0.08em;
  }
  .cs .mermaid-box {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 14px 10px;
    margin: 1.5em 0;
    overflow-x: auto;
    background: #fff;
  }
  /* Diagrams are not code blocks: drop the <pre> box styling. */
  .cs pre.mermaid {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    overflow: visible;
    font-size: 14px;
  }
  /* auto margins centre a diagram that fits; one that overflows starts at the
     left edge, so all of it stays reachable by scrolling */
  .cs pre.mermaid > svg {
    display: block;
    margin: 0 auto;
  }
  .cs .math {
    font-style: normal;
    font-family: Georgia, "Times New Roman", serif;
  }
  .cs .table-scroll {
    overflow-x: auto;
    max-width: 100%;
  }
</style>
