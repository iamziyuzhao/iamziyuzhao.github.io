---
import Base from "./Base.astro";

const { frontmatter, rawContent } = Astro.props;
const date = frontmatter.date ? new Date(frontmatter.date) : null;
const dateLabel = date?.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
const words = typeof rawContent === "function" ? rawContent().trim().split(/\s+/).length : 0;
const readingMinutes = words ? Math.max(1, Math.round(words / 200)) : null;
---

<Base title={frontmatter.title} description={frontmatter.description}>
  <article class="prose post">
    <div class="eyebrow"><span class="lang-en">Blog</span><span class="lang-zh">博客</span></div>
    <h1>
      {frontmatter.titleZh ? (
        <>
          <span class="lang-en">{frontmatter.title}</span>
          <span class="lang-zh">{frontmatter.titleZh}</span>
        </>
      ) : (
        frontmatter.title
      )}
    </h1>
    <div class="meta post-meta">
      {dateLabel && <time datetime={date.toISOString().slice(0, 10)}>{dateLabel}</time>}
      {readingMinutes && (
        <span>
          {dateLabel && " · "}
          <span class="lang-en">{readingMinutes} min read</span>
          <span class="lang-zh">约 {readingMinutes} 分钟</span>
        </span>
      )}
    </div>
    <slot />
  </article>
</Base>
