---
import Base from "../../layouts/Base.astro";
import { formatDate } from "../../data/format";
import { posts } from "../../data/posts";
---

<Base title="Blog | Ziyu Zhao" description="Research notes, paper reading, implementation logs, and longer reflections on systems for AI.">
  <section class="prose">
    <h1>Blog</h1>
    <p class="blog-intro">
      Research notes, paper reading, implementation logs, and longer reflections on systems for AI.
    </p>
    <div class="post-list">
      {posts.map((post) => (
        <article class="post-item">
          <a class="post-title" href={`${post.url}/`}>{post.title}</a>
          <div class="post-date">
            {formatDate(post.date)}
            {post.readMins && <> · {post.readMins} min read</>}
            {post.category && <> · {post.category}</>}
          </div>
          {post.description && <p class="post-desc">{post.description}</p>}
        </article>
      ))}
    </div>
  </section>
</Base>
