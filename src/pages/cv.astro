---
import Base from "../layouts/Base.astro";
import LogoMark from "../components/LogoMark.astro";
import { education, experience, projects } from "../data/profile";
---

<Base title="CV | Albert Zhao">
  <section class="prose">
    <div class="eyebrow"><span class="lang-en">Curriculum Vitae</span><span class="lang-zh">简历</span></div>
    <h1>CV</h1>
    <p class="muted">
      <span class="lang-en">A concise web version of my CV. A PDF version can be added or updated as the canonical document evolves.</span>
      <span class="lang-zh">这是一版简洁的网页版简历；PDF 会作为正式版本持续更新。</span>
    </p>
    <p><a href="/files/2026ZiyuZhaoJune.pdf"><span class="lang-en">Download PDF CV</span><span class="lang-zh">下载 PDF 简历</span></a></p>
  </section>

  <section class="section">
    <h2><span class="lang-en">Education</span><span class="lang-zh">教育</span></h2>
    <div class="list">
      {education.map((item) => (
        <article class="item">
          <div class="affiliation-row">
            <LogoMark item={item} />
            <div>
              <div class="item-title">{item.school}</div>
              <div class="meta">
                <span class="lang-en">{item.degree}</span>
                <span class="lang-zh">{item.degreeZh}</span>
              </div>
              <p>
                <span class="lang-en">{item.meta}</span>
                <span class="lang-zh">{item.metaZh}</span>
              </p>
            </div>
          </div>
          <time>{item.date}</time>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <h2><span class="lang-en">Professional Experience</span><span class="lang-zh">专业经历</span></h2>
    <div class="list">
      {experience.map((item) => (
        <article class="item">
          <div class="affiliation-row">
            <LogoMark item={item} />
            <div>
              <div class="item-title">{item.org}</div>
              <div class="meta">
                <span class="lang-en">{item.role}</span>
                <span class="lang-zh">{item.roleZh}</span>
              </div>
              <p>
                <span class="lang-en">{item.detail}</span>
                <span class="lang-zh">{item.detailZh}</span>
              </p>
            </div>
          </div>
          <time>{item.date}</time>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <h2><span class="lang-en">Open Source & Competition</span><span class="lang-zh">开源与竞赛</span></h2>
    <div class="list">
      {projects.map((project) => (
        <article class="item">
          <div class="affiliation-row">
            <LogoMark item={project} />
            <div>
              <div class="item-title">{project.title}</div>
              <div class="meta">
                <span class="lang-en">{project.venue}</span>
                <span class="lang-zh">{project.venueZh}</span>
              </div>
              <p>
                <span class="lang-en">{project.summary}</span>
                <span class="lang-zh">{project.summaryZh}</span>
              </p>
            </div>
          </div>
          <time>{project.date}</time>
        </article>
      ))}
    </div>
  </section>
</Base>
