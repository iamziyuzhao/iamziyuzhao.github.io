---
// A bookshelf of spines. Each spine's size, color and title layout are worked
// out here at build time. The script below lays the books out to fit the page
// (one row when it is wide enough, otherwise rows of about equal length) and
// shows a card for the book under the mouse, or tapped on a phone.
import type { Book } from "../data/books";

interface Props {
  books: Book[];
}

const { books } = Astro.props;

// Muted cloth colors as [spine, title]. Neighbouring books step 5 places
// through this list, so similar colors never end up side by side.
const PALETTE: [string, string][] = [
  ["#2f3d38", "#efe9dc"], // deep green
  ["#e7e2d6", "#3b3833"], // cream
  ["#b7ab7c", "#2f2c25"], // khaki
  ["#ecebe7", "#555049"], // paper white
  ["#8b9a82", "#f6f3ea"], // sage
  ["#3d3b39", "#efe9dc"], // charcoal
  ["#6f8489", "#f4f1ea"], // slate teal
  ["#dcd5c6", "#3b3833"], // sand
  ["#6c7b93", "#f4f1ea"], // grey blue
  ["#8d7570", "#f4efe8"], // mauve
  ["#6f8f87", "#f4f1ea"], // dusty teal
  ["#a49b8c", "#2f2c25"], // taupe
];

const WIDTH = { thin: 26, medium: 30, thick: 36 };
const CJK = /[㐀-鿿豈-﫿]/;

/** Small stable hash, so a book keeps its height when the list is reordered. */
function hash(s: string) {
  let h = 7;
  for (const ch of s) h = (h * 31 + ch.codePointAt(0)!) >>> 0;
  return h;
}

const LINE_HEIGHT = 1.15; // keep in step with .book-title in global.css

/** Font size and line count for `text` set vertically along `room` px: the
 *  fewest lines (up to 3) that keep it at least `min` px, at most `max` px. */
function fit(text: string, room: number, max: number, min: number) {
  const advance = CJK.test(text) ? 1.04 : 0.56; // average glyph width, in em
  const chars = [...text].length;
  for (let lines = 1; lines <= 3; lines++) {
    // A wrapped line breaks between words, so leave it a little slack.
    const perLine = lines === 1 ? chars : chars / lines + 2;
    const size = room / (perLine * advance);
    if (size >= min) return { size: Math.min(size, lines === 1 ? max : Math.min(max, 12)), lines };
  }
  return { size: min, lines: 3 };
}

/** Spine size (px at scale 1), title and subtitle font sizes, and colors. A
 *  title with a colon puts the part after it in a smaller subtitle. */
function layout(book: Book, n: number) {
  const text = book.spine ?? book.title;
  const [, main = text, sub = ""] = text.match(/^(.+?)\s*[:：]\s*(.+)$/) ?? [];
  const height = 152 + (hash(book.title) % 28);
  const room = height - 30; // length of spine left for the title

  const m = fit(main, room, CJK.test(main) ? 17 : 15, 10);
  const s = sub ? fit(sub, room, Math.min(9.5, m.size * 0.75), 7.5) : null;
  const columns = m.lines * m.size + (s ? s.lines * s.size + 2 / LINE_HEIGHT : 0);
  const width = Math.max(WIDTH[book.thickness ?? "medium"], Math.round(columns * LINE_HEIGHT + 9));

  const [spine, ink] = PALETTE[(n * 5) % PALETTE.length];
  const round = (x: number) => Math.round(x * 10) / 10;
  return { main, sub, width, height, size: round(m.size), subSize: s ? round(s.size) : 0, spine, ink };
}

const spines = books.map((book, i) => ({ book, n: i + 1, ...layout(book, i + 1) }));
---

<div class="bookshelf">
  <div class="book-card" aria-hidden="true">
    <span class="book-card-n"></span>
    <span class="book-card-text">
      <span class="book-card-title"></span>
      <span class="book-card-author"></span>
    </span>
    <a class="book-card-link" target="_blank" rel="noopener" tabindex="-1"></a>
  </div>
  <div class="shelves">
    <div class="shelf">
      {spines.map((s) => (
        <a
          class="book"
          href={s.book.href}
          target="_blank"
          rel="noopener"
          aria-label={`${s.book.title}, ${s.book.author}`}
          data-n={s.n}
          data-title={s.book.title}
          data-author={s.book.author}
          data-label={s.book.linkLabel ?? "Buy at Amazon"}
          style={`--w:${s.width};--h:${s.height};--fs:${s.size};--fs2:${s.subSize};--spine:${s.spine};--ink:${s.ink}`}
        >
          <span class="book-title">
            <span class="book-main">{s.main}</span>
            {s.sub && <span class="book-sub">{s.sub}</span>}
          </span>
        </a>
      ))}
    </div>
  </div>
</div>

<script>
  const shelf = document.querySelector<HTMLElement>(".bookshelf");

  if (shelf) {
    const shelvesEl = shelf.querySelector<HTMLElement>(".shelves")!;
    const books = [...shelf.querySelectorAll<HTMLAnchorElement>(".book")];

    // ---- Layout -------------------------------------------------------------
    // Spines are sized in px at scale 1 (--w) and drawn at scale --k. Pick the
    // fewest rows that keep --k at or above K_MIN, split the books into rows
    // of about equal length, then set --k so the longest row fills the width
    // (never above K_MAX, so a wide page keeps books at a natural size).
    const K_MIN = 0.85;
    const K_MAX = 1.15;
    const style = getComputedStyle(shelf);
    const gap = Number(style.getPropertyValue("--gap")) || 3; // between spines
    const pad = 2 * (Number(style.getPropertyValue("--pad")) || 8); // row ends
    const widths = books.map((b) => Number(b.style.getPropertyValue("--w")));

    const rowWidth = (row: number[]) =>
      row.reduce((sum, i) => sum + widths[i], 0) + gap * (row.length - 1) + pad;

    /** Books in order, a new row whenever the next one would pass `cap`. */
    const pack = (cap: number) => {
      const rows: number[][] = [[]];
      widths.forEach((_, i) => {
        const row = rows[rows.length - 1];
        if (row.length > 0 && rowWidth([...row, i]) > cap) rows.push([i]);
        else row.push(i);
      });
      return rows;
    };

    /** `n` rows whose longest is as short as possible. */
    const balance = (n: number) => {
      let lo = Math.max(...widths) + pad;
      let hi = rowWidth(widths.map((_, i) => i));
      while (hi - lo > 0.5) {
        const mid = (lo + hi) / 2;
        if (pack(mid).length <= n) hi = mid;
        else lo = mid;
      }
      return pack(hi);
    };

    let current = "";
    const arrange = () => {
      const room = shelf.parentElement!.clientWidth - 1;
      let rows = balance(1);
      let k = room / rowWidth(rows[0]);
      for (let n = 2; k < K_MIN && n <= books.length; n++) {
        rows = balance(n);
        k = room / Math.max(...rows.map(rowWidth));
      }
      shelf.style.setProperty("--k", Math.min(k, K_MAX).toFixed(3));

      const key = rows.map((r) => r.length).join(",");
      if (key === current) return;
      current = key;
      shelvesEl.replaceChildren(
        ...rows.map((row) => {
          const el = document.createElement("div");
          el.className = "shelf";
          el.append(...row.map((i) => books[i]));
          return el;
        }),
      );
    };

    let frame = 0;
    new ResizeObserver(() => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(arrange);
    }).observe(shelf.parentElement!);

    // ---- Card ---------------------------------------------------------------
    // The card follows the book under the mouse, or the one focused from the
    // keyboard. On touch screens the first tap only picks a book; a second tap
    // on it, or the card's link, opens it.
    const card = shelf.querySelector<HTMLElement>(".book-card")!;
    const part = (name: string) => card.querySelector<HTMLElement>(`.book-card-${name}`)!;
    const link = part("link") as HTMLAnchorElement;
    let active: HTMLAnchorElement | null = null;
    let lastPointer = "mouse";

    const pick = (book: HTMLAnchorElement | null) => {
      if (book === active) return;
      active?.classList.remove("is-active");
      active = book;
      shelf.classList.toggle("has-active", book !== null);
      if (!book) return;
      book.classList.add("is-active");
      part("n").textContent = book.dataset.n!;
      part("title").textContent = book.dataset.title!;
      part("author").textContent = book.dataset.author!;
      link.href = book.href;
      link.textContent = book.dataset.label!;
    };

    for (const book of books) {
      book.addEventListener("pointerenter", (e) => {
        if (e.pointerType === "mouse") pick(book);
      });
      book.addEventListener("pointerdown", (e) => {
        lastPointer = e.pointerType;
      });
      book.addEventListener("focus", () => {
        if (book.matches(":focus-visible")) pick(book);
      });
      book.addEventListener("click", (e) => {
        if (lastPointer !== "mouse" && book !== active) {
          e.preventDefault();
          pick(book);
        }
      });
    }

    shelf.addEventListener("pointerleave", (e) => {
      if (e.pointerType === "mouse") pick(null);
    });
    shelf.addEventListener("focusout", (e) => {
      if (!shelf.contains(e.relatedTarget as Node | null)) pick(null);
    });
    document.addEventListener("pointerdown", (e) => {
      if (!shelf.contains(e.target as Node)) pick(null);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") pick(null);
    });
  }
</script>
