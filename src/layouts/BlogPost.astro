---
import Base from "./Base.astro";
import Comments from "../components/Comments.astro";

const { frontmatter, rawContent } = Astro.props;
const date = frontmatter.date ? new Date(frontmatter.date) : null;
const dateIso = date?.toISOString().slice(0, 10);
const words = typeof rawContent === "function" ? rawContent().trim().split(/\s+/).length : 0;
const readingMinutes = words ? Math.max(1, Math.round(words / 200)) : null;
const slug = Astro.url.pathname.replace(/\/+$/, "").split("/").pop();
---

<Base title={frontmatter.title} description={frontmatter.description}>
  <article class="prose post">
    <div class="term-path"><span class="tp-cmd" aria-hidden="true">$ cat&nbsp;</span><a href="/blog/">~/blog/</a><span class="tp-file">{slug}.md</span></div>
    <h1>
      {frontmatter.titleZh ? (
        <>
          <span class="lang-en">{frontmatter.title}</span>
          <span class="lang-zh">{frontmatter.titleZh}</span>
        </>
      ) : (
        frontmatter.title
      )}
    </h1>
    <div class="meta post-meta">
      {dateIso && (
        <span class="meta-tok">
          <span class="tok-tag" aria-hidden="true">@date</span>
          <time datetime={dateIso}>{dateIso}</time>
        </span>
      )}
      {readingMinutes && (
        <span class="meta-tok">
          <span class="tok-tag" aria-hidden="true">@read</span>
          <span class="lang-en">{readingMinutes} min</span>
          <span class="lang-zh">{readingMinutes} 分钟</span>
        </span>
      )}
      {(frontmatter.category || frontmatter.categoryZh) && (
        <span class="meta-tok">
          <span class="tok-tag" aria-hidden="true">@topic</span>
          <span class="lang-en">{frontmatter.category}</span>
          <span class="lang-zh">{frontmatter.categoryZh ?? frontmatter.category}</span>
        </span>
      )}
    </div>
    <slot />
    <Comments />
  </article>
</Base>
