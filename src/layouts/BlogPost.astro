---
import Base from "./Base.astro";
import Comments from "../components/Comments.astro";
import { formatDate } from "../data/format";

const { frontmatter, rawContent } = Astro.props;
const words = typeof rawContent === "function" ? rawContent().trim().split(/\s+/).length : 0;
const readingMinutes = words ? Math.max(1, Math.round(words / 200)) : null;
---

<Base title={`${frontmatter.title} | Ziyu Zhao`} description={frontmatter.description}>
  <article class="prose post">
    <h1>{frontmatter.title}</h1>
    <div class="post-meta">
      {frontmatter.date && <time datetime={new Date(frontmatter.date).toISOString().slice(0, 10)}>{formatDate(frontmatter.date)}</time>}
      {readingMinutes && <> · {readingMinutes} min read</>}
      {frontmatter.category && <> · {frontmatter.category}</>}
    </div>
    <slot />
    <Comments />
  </article>
</Base>
