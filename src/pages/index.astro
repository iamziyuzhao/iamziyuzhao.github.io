---
import Base from "../layouts/Base.astro";
import LogoMark from "../components/LogoMark.astro";
import { education, experience, news, newsZh, profile, projects } from "../data/profile";

const focusAreas = [
  { en: "LLM inference", zh: "LLM 推理" },
  { en: "GPU kernels", zh: "GPU kernels" },
  { en: "Agent runtimes", zh: "Agent 运行时" },
  { en: "Evaluation infrastructure", zh: "评测基础设施" },
];

const profileStats = [
  { value: "CMU MSIN", valueZh: "CMU MSIN", label: "Incoming", labelZh: "入学" },
  { value: "Systems for AI", valueZh: "AI 系统", label: "Research", labelZh: "研究方向" },
  { value: "Pittsburgh", valueZh: "匹兹堡", label: "Base", labelZh: "所在地" },
];
---

<Base title="Albert (Ziyu) Zhao">
  <section class="academic-shell">
    <aside class="profile-card">
      <div class="portrait-frame">
        <img class="portrait" src="/images/albert-zhao.jpg" alt="Albert Zhao" loading="eager" />
      </div>
      <div class="profile-name">Albert (Ziyu) Zhao</div>
      <div class="profile-title">
        <span class="lang-en">{profile.title}</span>
        <span class="lang-zh">{profile.titleZh}</span>
      </div>
      <div class="profile-detail">
        <span class="lang-en">Incoming M.S. student</span>
        <span class="lang-zh">硕士新生</span>
        <br />
        Carnegie Mellon University
        <br />
        Pittsburgh, PA
      </div>
      <div class="profile-links" aria-label="Profile links">
        {profile.links.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
      <p class="profile-note">
        <span class="lang-en">Interested in the systems layer below large models: serving, kernels, runtimes, and evaluation infrastructure.</span>
        <span class="lang-zh">关注大模型之下的系统层：serving、kernels、runtimes 与评测基础设施。</span>
      </p>
    </aside>

    <div class="academic-main">
      <section class="terminal-hero" aria-label="Introduction">
        <div class="term-window">
          <div class="term-bar">
            <span class="term-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="term-title" aria-hidden="true">albert@cmu:~ — zsh</span>
            <span class="term-size" aria-hidden="true">80×24</span>
          </div>
          <div class="term-body">
            <p class="term-line"><span class="term-prompt" aria-hidden="true">$</span><span class="term-cmd type-6">whoami</span></p>
            <h1 class="term-name">
              <span class="visually-hidden">Albert (Ziyu) Zhao</span>
              <img class="term-name-img" src="/images/name-newyork.png" alt="Albert (Ziyu) Zhao" width="2099" height="240" decoding="async" />
            </h1>
            <p class="term-out term-role">
              <span class="lang-en">{profile.title}</span>
              <span class="lang-zh">{profile.titleZh}</span>
            </p>
            <p class="term-out term-dim">
              <span class="lang-en">incoming M.S. student · Carnegie Mellon University · Pittsburgh, PA</span>
              <span class="lang-zh">硕士新生 · Carnegie Mellon University · Pittsburgh, PA</span>
            </p>
            <p class="term-line"><span class="term-prompt" aria-hidden="true">$</span><span class="term-cmd type-13">cat focus.txt</span></p>
            {focusAreas.map((area, i) => (
              <p class="term-out term-focus">
                <span class="term-idx" aria-hidden="true">{i}:</span>
                <span class="lang-en">{area.en}</span>
                <span class="lang-zh">{area.zh}</span>
              </p>
            ))}
            <p class="term-line term-last"><span class="term-prompt" aria-hidden="true">$</span><span class="term-cmd type-17" data-boot-cmd>source ~/.profile</span><span class="term-cursor" aria-hidden="true" data-static-cursor></span></p>
          </div>
        </div>
      </section>

      <section class="section about-section">
        <h2><span class="lang-en">About</span><span class="lang-zh">关于</span></h2>
        <p>
          <span class="lang-en">{profile.intro}</span>
          <span class="lang-zh">{profile.introZh}</span>
        </p>
        <p>
          <span class="lang-en">{profile.focus}</span>
          <span class="lang-zh">{profile.focusZh}</span>
        </p>
        <div class="fact-strip" aria-label="Profile summary">
          {profileStats.map((stat) => (
            <span>
              <small>
                <span class="lang-en">{stat.label}</span>
                <span class="lang-zh">{stat.labelZh}</span>
              </small>
              <strong>
                <span class="lang-en">{stat.value}</span>
                <span class="lang-zh">{stat.valueZh}</span>
              </strong>
            </span>
          ))}
        </div>
      </section>

      <section class="content-card">
        <div class="cv-grid">
          <div class="cv-block">
            <h2><span class="lang-en">Education</span><span class="lang-zh">教育</span></h2>
            <ul class="cv-list">
              {education.map((item) => (
                <li>
                  <div class="affiliation-row">
                    <LogoMark item={item} />
                    <span>
                      <strong>{item.school}</strong>
                      <span class="lang-en">{item.degree}</span>
                      <span class="lang-zh">{item.degreeZh}</span>
                      <br />
                      <span class="date-chip">{item.date}</span>
                      <br />
                      <span class="lang-en">{item.meta}</span>
                      <span class="lang-zh">{item.metaZh}</span>
                    </span>
                  </div>
                </li>
              ))}
            </ul>
          </div>

          <div class="cv-block">
            <h2><span class="lang-en">Experience</span><span class="lang-zh">经历</span></h2>
            <ul class="cv-list">
              {experience.map((item) => (
                <li>
                  <div class="affiliation-row">
                    <LogoMark item={item} />
                    <span>
                      <strong>{item.org}</strong>
                      <span class="lang-en">{item.role}</span>
                      <span class="lang-zh">{item.roleZh}</span>
                      <br />
                      <span class="date-chip">{item.date}</span>
                      <span class="code-comment">
                        <span class="lang-en">{item.detail}</span>
                        <span class="lang-zh">{item.detailZh}</span>
                      </span>
                    </span>
                  </div>
                </li>
              ))}
            </ul>

          </div>
        </div>
      </section>

      <section class="content-card" id="projects">
        <div class="section-heading">
          <h2><span class="lang-en">Projects</span><span class="lang-zh">项目</span></h2>
          <span class="shell-hint" aria-hidden="true">$ ls ~/projects/</span>
        </div>
        <ul class="project-list">
          {projects.map((project) => (
            <li>
              <div class="project-row">
                <span class="project-title">
                  {project.links.length > 0 ? <a href={project.links[0].href}>{project.title}</a> : project.title}
                </span>
                <span class="project-venue">
                  <span class="lang-en">{project.venue}</span>
                  <span class="lang-zh">{project.venueZh}</span>
                </span>
                <span class="date-chip">{project.date}</span>
              </div>
              <p class="code-comment">
                <span class="lang-en">{project.summary}</span>
                <span class="lang-zh">{project.summaryZh}</span>
              </p>
            </li>
          ))}
        </ul>
      </section>

      <section class="content-card">
        <div class="section-heading">
          <h2><span class="lang-en">News</span><span class="lang-zh">动态</span></h2>
          <span class="shell-hint" aria-hidden="true">$ tail -n 4 news.log</span>
        </div>
        <ul class="news-list">
          {news.map((item, index) => (
            <li>
              <span class="log-ln" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <time>{item.slice(0, 4)}</time>
              <span>
                <span class="lang-en">{item.replace(/^\d{4}:\s*/, "")}</span>
                <span class="lang-zh">{newsZh[index].replace(/^\d{4}：\s*/, "")}</span>
              </span>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </section>
</Base>

<script>
  // === New York pixel-reveal: the name materializes pixel-by-pixel ===========
  // Progressive enhancement. The <img class="term-name-img"> is the default
  // visible name (no-JS + reduced-motion show the crisp serif). When motion is
  // allowed and the boot is not skipped, an overlay <canvas> sweeps the name in
  // left-to-right as pixel cells, then is removed to reveal the crisp img.
  (() => {
    const html = document.documentElement;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const h1 = document.querySelector("h1.term-name");
    const img = h1?.querySelector(".term-name-img") as HTMLImageElement | null;
    // only animate during the home boot; otherwise the crisp img just stays
    if (reduce || !h1 || !img || !html.classList.contains("booting")) return;

    let done = false;
    let canvas: HTMLCanvasElement | null = null;
    const finish = () => {
      if (done) return;
      done = true;
      canvas?.remove();
      h1.classList.remove("is-revealing");
    };
    // a skip at any time lands the crisp img immediately
    const onSkip = () => finish();
    document.addEventListener("keydown", onSkip, true);
    document.addEventListener("pointerdown", onSkip, true);

    const draw = () => {
      if (done || html.classList.contains("skip")) return finish();
      const box = img.getBoundingClientRect();
      const cw = box.width, ch = box.height;
      if (!cw || !ch) return finish();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas = document.createElement("canvas");
      canvas.className = "term-name-canvas";
      canvas.setAttribute("aria-hidden", "true");
      canvas.width = Math.round(cw * dpr);
      canvas.height = Math.round(ch * dpr);
      const ctx = canvas.getContext("2d");
      if (!ctx) return finish();
      h1.classList.add("is-revealing");
      h1.insertBefore(canvas, img);

      // offscreen buffer of the source PNG at backing resolution
      const off = document.createElement("canvas");
      off.width = canvas.width;
      off.height = canvas.height;
      const octx = off.getContext("2d")!;
      octx.drawImage(img, 0, 0, off.width, off.height);
      const data = octx.getImageData(0, 0, off.width, off.height).data;

      // ~3 CSS px per cell → name reads as built-from-pixels but stays legible
      const cell = Math.max(2, Math.round(3 * dpr));
      const cols = Math.ceil(canvas.width / cell);
      const rows = Math.ceil(canvas.height / cell);
      const cells: { x: number; y: number; a: number; t: number }[] = [];
      for (let cx = 0; cx < cols; cx++) {
        for (let cy = 0; cy < rows; cy++) {
          let sum = 0, n = 0;
          for (let px = cx * cell; px < Math.min((cx + 1) * cell, canvas.width); px++)
            for (let py = cy * cell; py < Math.min((cy + 1) * cell, canvas.height); py++) {
              sum += data[(py * canvas.width + px) * 4 + 3];
              n++;
            }
          const a = n ? sum / n / 255 : 0;
          if (a > 0.08)
            // per-cell jitter (a few cells ahead/behind) so it shimmers in
            cells.push({ x: cx * cell, y: cy * cell, a, t: cx + (Math.random() * 6 - 3) });
        }
      }

      const DUR = 850; // ms — within the 0.9–1.2s target, fits before source
      const maxT = cols + 3;
      const start = performance.now();
      const tick = (now: number) => {
        if (done || html.classList.contains("skip")) return finish();
        const p = Math.min(1, (now - start) / DUR);
        const headCol = p * maxT; // current sweep column (in cell units)
        ctx.clearRect(0, 0, canvas!.width, canvas!.height);
        for (const c of cells) {
          if (c.t <= headCol) {
            ctx.fillStyle = "#fff";
            ctx.globalAlpha = c.a;
            ctx.fillRect(c.x, c.y, cell, cell);
          }
        }
        ctx.globalAlpha = 1;
        // thin red leading bar marking the current column
        if (p < 1) {
          const bx = Math.min(canvas!.width - 2, headCol * cell);
          ctx.fillStyle = getComputedStyle(html).getPropertyValue("--term-red") || "#e3554d";
          ctx.fillRect(bx, 0, Math.max(2, Math.round(dpr)), canvas!.height);
        }
        if (p < 1) requestAnimationFrame(tick);
        else finish();
      };
      requestAnimationFrame(tick);
    };

    // start the sweep just as the name line lands (~0.55s, CSS delay is 0.50s)
    const kick = () => {
      if (img.complete) setTimeout(draw, 550);
      else img.addEventListener("load", () => setTimeout(draw, 550), { once: true });
    };
    kick();
  })();

  // tiny interactive shell — progressive enhancement on the hero terminal
  const win = document.querySelector(".term-window");
  const tb = win?.querySelector(".term-body");
  if (win && tb) {
    tb.querySelector("[data-static-cursor]")?.remove();
    const live = document.createElement("p");
    live.className = "term-line term-live";
    live.innerHTML =
      '<span class="term-prompt" aria-hidden="true">$</span><span class="term-typed"></span><span class="term-cursor" aria-hidden="true"></span>';
    const input = document.createElement("input");
    input.className = "term-input";
    input.type = "text";
    input.setAttribute("aria-label", "Interactive terminal. Type help and press Enter.");
    input.autocapitalize = "none";
    input.autocomplete = "off";
    input.spellcheck = false;
    tb.append(live, input);
    const typed = live.querySelector(".term-typed") as HTMLElement;
    const out = (text: string) => {
      const p = document.createElement("p");
      p.className = "term-out";
      p.textContent = text;
      tb.insertBefore(p, live);
    };
    const commands: Record<string, () => void> = {
      help: () => out("commands: help  ls  cat focus.txt  source ~/.profile  open blog  clear"),
      ls: () => out("blog/  projects/  focus.txt"),
      "source ~/.profile": () => out("profile already loaded — you're looking at it"),
      "cat focus.txt": () =>
        tb.querySelectorAll("p.term-focus").forEach((line) => {
          const copy = line.cloneNode(true) as HTMLElement;
          copy.classList.remove("term-hidden");
          tb.insertBefore(copy, live);
        }),
      "open blog": () => {
        out("opening ~/blog ...");
        window.location.href = "/blog/";
      },
      clear: () =>
        [...tb.children].forEach((el) => {
          if (el !== live && el !== input) el.classList.add("term-hidden");
        }),
    };
    const run = (raw: string) => {
      const echo = document.createElement("p");
      echo.className = "term-line";
      const prompt = document.createElement("span");
      prompt.className = "term-prompt";
      prompt.textContent = "$";
      echo.append(prompt, document.createTextNode(raw));
      tb.insertBefore(echo, live);
      const cmd = raw.trim();
      if (!cmd) return;
      if (commands[cmd]) commands[cmd]();
      else out("zsh: command not found: " + cmd.split(/\s+/)[0]);
    };
    input.addEventListener("focus", () => win.classList.add("shell-on"));
    input.addEventListener("input", () => (typed.textContent = input.value));
    input.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        run(input.value);
        input.value = "";
        typed.textContent = "";
      } else if (e.key === "Escape") input.blur();
    });
    tb.addEventListener("click", (e) => {
      if (e.target instanceof Element && e.target.closest("a")) return;
      win.classList.add("shell-on");
      input.focus({ preventScroll: true });
    });
  }
</script>
