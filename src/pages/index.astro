---
import Base from "../layouts/Base.astro";
import Bookshelf from "../components/Bookshelf.astro";
import LogoMark from "../components/LogoMark.astro";
import RepoStats from "../components/RepoStats.astro";
import { books } from "../data/books";
import { education, experience, papers, preSeedArticle, profile, projects } from "../data/profile";
import { formatDate } from "../data/format";
import { fetchRepoStats } from "../data/github";
import { posts } from "../data/posts";

const latestPosts = posts.slice(0, 3);
const repoStats = await fetchRepoStats(projects.flatMap((p) => (p.repo ? [p.repo] : [])));
---

<Base
  title="Ziyu Zhao (Albert)"
  description="Ziyu (Albert) Zhao — M.S. student at Carnegie Mellon University researching recursive self-improvement, continual learning, and post-training."
  nav={false}
>
  <header class="profile">
    <div class="profile-info">
      <h1>{profile.name} <span class="nickname">({profile.nickname})</span></h1>
      <p>
        I am a first-year M.S. student in Information Networking at Carnegie Mellon University, advised by <a href="https://www.andrew.cmu.edu/user/beidic/" target="_blank" rel="noreferrer">Prof. Beidi Chen</a>. My research explores how to expand the capabilities of LLM agents and how to build efficient systems to train them.
      </p>
      <p>
        Previously, I was a research engineer focused on post-training infrastructure at Tencent Hunyuan, where I worked on scaling long-horizon agentic capabilities for the <a href="https://hy.tencent.ai/research/hy3" target="_blank" rel="noreferrer">Hy3 model</a>. Motivated by the challenge of policy staleness in agentic reinforcement learning, I joined the <a href="https://www.csl.cornell.edu/faculty/" target="_blank" rel="noreferrer">Computer Systems Lab</a> at Cornell University, where I worked with <a href="https://www.mohsaied.com/" target="_blank" rel="noreferrer">Prof. Mohamed S. Abdelfattah</a> on efficient quantized LLM inference to accelerate rollout generation.
      </p>
      <p>
        During my undergraduate studies at the University of Rochester, I was glad to work with the Google Cloud team that built search and API infrastructure at <a href="https://www.haystackteam.com/key-features/universal-search" target="_blank" rel="noreferrer">Haystack</a>. Inspired by the power of search and recommendation algorithms, several colleagues and I founded the AI company GetMyHome.ai (now <a href="https://www.realkey.ai/" target="_blank" rel="noreferrer">RealKey</a>), where we raised <a href={preSeedArticle} target="_blank" rel="noreferrer">$1.5 million</a> in a pre-seed round.
      </p>
      <nav class="social-links" aria-label="Profile links">
        {profile.links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </div>
    <div class="profile-side" data-morph-src={profile.morph.src} data-morph-frames={profile.morph.frames}>
      <button class="profile-photo" type="button" aria-pressed="false" aria-label="Turn into Sun Wukong">
        <span class="flip-card">
          <img class="flip-front" src={profile.photo} alt="Ziyu (Albert) Zhao" width="1280" height="960" />
          <img class="flip-back" src={profile.alterEgo.src} alt={profile.alterEgo.alt} width="480" height="480" fetchpriority="high" />
          <span class="morph" aria-hidden="true"></span>
        </span>
      </button>
      <div class="research-interests">
        <div class="interests-list">
          <h2>Research Interests</h2>
          <ul>
            {profile.researchInterests.map((topic) => <li>{topic}</li>)}
          </ul>
        </div>
        <p class="motto">
          <span class="motto-zh" lang="zh">{profile.motto.zh}</span>
          <span class="motto-en">{profile.motto.en}</span>
        </p>
      </div>
    </div>
    <script is:inline>
      document.querySelector(".profile-side").classList.add("is-flipped");
    </script>
  </header>

  <section>
    <h2 class="section-heading">Publication</h2>
    <div class="entries">
      {papers.map((paper) => (
        <div class="entry paper">
          <a class="paper-image" href={paper.href} target="_blank" rel="noreferrer">
            <img src={paper.image} alt="" loading="lazy" />
          </a>
          <div class="entry-body">
            <div class="entry-name">
              <a href={paper.href} target="_blank" rel="noreferrer">{paper.title}</a>
            </div>
            <div class="paper-authors">
              {paper.authors.map((author, i) => (
                <>
                  {i > 0 && ", "}
                  {author === profile.name ? <strong>{author}</strong> : author}
                </>
              ))}
            </div>
            <div class="paper-venue">{paper.venue}</div>
            <div class="entry-links">
              {paper.links.map((link) => (
                <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section>
    <h2 class="section-heading">Projects</h2>
    <div class="entries">
      {projects.map((item) => (
        <div class="entry">
          <LogoMark logos={item.logos} href={item.href} />
          <div class="entry-body">
            <div class:list={["entry-name", { "with-stats": item.repo }]}>
              {item.href ? <a href={item.href} target="_blank" rel="noreferrer">{item.title}</a> : item.title}
              {item.repo && <RepoStats repo={item.repo} stats={repoStats[item.repo]} />}
            </div>
            <div class="entry-date">{item.venue}</div>
            <div class="entry-role">{item.role}</div>
            <div class="entry-detail" set:html={item.summary} />
            {item.links && (
              <div class="entry-links">
                {item.links.map((link) => (
                  <a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel="noreferrer">
                    {link.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section>
    <h2 class="section-heading">Education</h2>
    <div class="entries">
      {education.map((item) => (
        <div class="entry">
          <LogoMark logos={item.logos} />
          <div class="entry-body">
            <div class="entry-name">{item.school}</div>
            <div class="entry-date">{item.date}</div>
            <div class="entry-role">{item.degree}</div>
            {item.note && <div class="entry-detail">{item.note}</div>}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section>
    <h2 class="section-heading">Experience</h2>
    <div class="entries">
      {experience.map((item) => (
        <div class="entry">
          <LogoMark logos={item.logos} href={item.href} />
          <div class="entry-body">
            <div class="entry-name">{item.org}</div>
            <div class="entry-date">{item.date}</div>
            <div class="entry-role">{item.role}</div>
            <div class="entry-detail" set:html={item.detail} />
          </div>
        </div>
      ))}
    </div>
  </section>

  <section>
    <h2 class="section-heading">Blog</h2>
    <div class="post-list">
      {latestPosts.map((post) => (
        <article class="post-item">
          <a class="post-title" href={`${post.url}/`}>{post.title}</a>
          <div class="post-date">{formatDate(post.date)}</div>
          {post.description && <p class="post-desc">{post.description}</p>}
        </article>
      ))}
    </div>
    {posts.length > latestPosts.length && <p class="more-link"><a href="/blog/">All posts →</a></p>}
  </section>

  <section>
    <h2 class="section-heading">Books</h2>
    <p class="books-intro">
      Books have changed my life. I enjoy reading and giving good books to friends. It's always fun to learn how other people think. Here are a few that have stayed with me.
    </p>
    <Bookshelf books={books} />
  </section>
</Base>

<script>
  // Wukong <-> photo morph. The page opens on Wukong (an inline script adds
  // .is-flipped before first paint); 1.5s in, the morph strip plays and
  // Wukong turns into the photo. Hover, focus, or a tap plays it backwards
  // (photo -> Wukong); leaving plays it forward again. A run that is
  // interrupted turns around from the frame it is on.
  const side = document.querySelector<HTMLElement>(".profile-side");
  const photo = side?.querySelector<HTMLButtonElement>(".profile-photo");
  const morph = side?.querySelector<HTMLElement>(".morph");
  if (side && photo && morph) {
    const FRAMES = Number(side.dataset.morphFrames);
    const LAST = FRAMES - 1;
    const FULL_MS = 1300; // one full Wukong -> photo run
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let frame = 0; // the page opens on Wukong
    let raf = 0;
    let pinned = false; // a tap/click keeps Wukong up until tapped again
    let ready = false;

    const show = (f: number) => {
      morph.style.backgroundPositionX = `${(f / LAST) * 100}%`;
    };
    // the static picture underneath and the text follow the target side
    const setSide = (wukong: boolean) => {
      side.classList.toggle("is-flipped", wukong);
      photo.setAttribute("aria-pressed", String(wukong));
    };

    const animateTo = (target: number) => {
      cancelAnimationFrame(raf);
      setSide(target === 0);
      if (reduceMotion || !ready || frame === target) {
        frame = target;
        morph.classList.remove("is-playing");
        return;
      }
      const from = frame;
      const duration = (FULL_MS * Math.abs(target - from)) / LAST;
      const start = performance.now();
      morph.classList.add("is-playing");
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / duration);
        frame = Math.round(from + (target - from) * t);
        show(frame);
        if (t < 1) raf = requestAnimationFrame(step);
        else morph.classList.remove("is-playing");
      };
      show(from);
      raf = requestAnimationFrame(step);
    };

    const toWukong = () => animateTo(0);
    const toPhoto = () => {
      if (!pinned) animateTo(LAST);
    };

    // load the strip, then open the show 1.5s after the page started
    const strip = new Image();
    strip.src = side.dataset.morphSrc ?? "";
    strip
      .decode()
      .then(() => {
        morph.style.backgroundImage = `url(${strip.src})`;
        ready = true;
        const wait = Math.max(0, 1500 - performance.now());
        window.setTimeout(() => {
          if (frame === 0 && !pinned && !photo.matches(":hover")) toPhoto();
        }, wait);
      })
      .catch(() => {
        // no strip: fall back to a plain swap after the same pause
        window.setTimeout(() => toPhoto(), 1500);
      });

    photo.addEventListener("pointerenter", (e) => {
      if (e.pointerType === "mouse") toWukong();
    });
    photo.addEventListener("pointerleave", (e) => {
      if (e.pointerType === "mouse") toPhoto();
    });
    photo.addEventListener("focus", () => {
      if (photo.matches(":focus-visible")) toWukong();
    });
    photo.addEventListener("blur", toPhoto);
    photo.addEventListener("click", () => {
      pinned = !pinned;
      if (pinned) toWukong();
      else animateTo(LAST);
    });
  }
</script>
