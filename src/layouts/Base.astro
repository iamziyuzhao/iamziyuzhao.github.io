---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  /** Markdown pages using `layout:` pass their metadata here instead of as direct props. */
  frontmatter?: { title?: string; description?: string };
}

const { frontmatter } = Astro.props;
const title = Astro.props.title ?? frontmatter?.title ?? "Albert (Ziyu) Zhao";
const description =
  Astro.props.description ??
  frontmatter?.description ??
  "Academic personal website of Albert (Ziyu) Zhao.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Crimson+Pro:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      // boot sequence — home page only, motion permitting. Runs before first
      // paint so the rest of the page never flashes. Without JS this script
      // never runs, no class is added, and the site renders normally.
      //
      // Choreography: the terminal boots FULLSCREEN (a maximized terminal app)
      // and types its session. When "$ source ~/.profile" finishes typing, the
      // window shrinks + docks (FLIP on box geometry, ease-out glide) to its
      // natural in-flow rect. The dock FINISHES FIRST; only then does the rest
      // of the page print in top-to-bottom like the terminal is typing it out.
      // Any key/click skips pixel-exactly to the settled page.
      (function () {
        if (
          location.pathname !== "/" ||
          matchMedia("(prefers-reduced-motion: reduce)").matches
        )
          return;
        var html = document.documentElement;
        html.classList.add("booting");
        var card = null;
        var hero = null;
        var natural = null; // stored natural rect {top,left,width,height}
        var measured = false; // natural rect captured after fonts.ready
        var settleTimer = 0;
        var dockTimer = 0;
        var revealTimer = 0;
        var fallback = 0;
        var started = false;
        var dockEndHandler = null;

        // strip every trace of the boot geometry, leaving the card in normal
        // flow at its natural spot with no inline styles.
        var stripGeometry = function () {
          if (!card) return;
          card.classList.remove("boot-full", "boot-dock");
          card.style.cssText = "";
          if (dockEndHandler) {
            card.removeEventListener("transitionend", dockEndHandler);
            dockEndHandler = null;
          }
          if (hero) hero.style.removeProperty("min-height");
        };

        var teardown = function () {
          document.removeEventListener("animationend", onType);
          document.removeEventListener("keydown", skip, true);
          document.removeEventListener("pointerdown", skip, true);
          clearTimeout(fallback);
          clearTimeout(settleTimer);
          clearTimeout(dockTimer);
          clearTimeout(revealTimer);
          stripGeometry();
          // settled: drop the cascade class too so later language toggles and
          // interactions never re-trigger any boot animation
          html.classList.remove("booted");
        };

        // measure the card's natural rect (re-measured after fonts.ready so the
        // dock target is exact and never end-jumps from a stale serif metric),
        // lock the hero height to preserve layout, then pin the card fullscreen.
        // The card stays invisible under html.booting until .boot-full lands, so
        // the first painted frame is the maximized terminal — never the card.
        var measure = function () {
          if (!card) return;
          var r = card.getBoundingClientRect();
          natural = {
            top: r.top + scrollY,
            left: r.left + scrollX,
            width: r.width,
            height: r.height,
          };
        };

        var fullscreen = function () {
          card = document.querySelector(".terminal-hero .term-window");
          hero = document.querySelector(".terminal-hero");
          if (!card || !html.classList.contains("booting")) return;
          measure();
          // hold the in-flow space so nothing reflows while the card is fixed
          if (hero) hero.style.minHeight = hero.offsetHeight + "px";
          card.classList.add("boot-full");
          // re-measure once webfonts settle so the dock target is sub-pixel exact
          if (document.fonts && document.fonts.ready) {
            document.fonts.ready.then(function () {
              if (measured || !html.classList.contains("booting") || !hero)
                return;
              // briefly un-fix to read the true in-flow rect, then re-fix
              card.classList.remove("boot-full");
              hero.style.removeProperty("min-height");
              measure();
              hero.style.minHeight = hero.offsetHeight + "px";
              card.classList.add("boot-full");
              measured = true;
            });
          }
        };

        // start the typed page cascade — the dock has fully landed by now.
        var reveal = function () {
          html.classList.remove("booting");
          html.classList.add("booted");
          // the content reveal finishes ~1.8s in (footer is the last block at
          // ~1.5s + ramp); give it a small margin, then stop listening + drop
          // the booted class so the whole boot has settled by ~7s.
          settleTimer = setTimeout(teardown, 2600);
        };

        // shrink + dock: set the fixed inset to the stored natural rect so the
        // .boot-dock transitions carry the card home with an ease-out glide,
        // then strip on transitionend (inside a rAF, so the in-flow rect equals
        // the animated target to sub-pixel — no end-jump) and reveal the page.
        var dock = function () {
          if (!card || !natural) {
            reveal();
            return;
          }
          // ensure the fullscreen inset is the committed starting point
          card.style.top = "0px";
          card.style.left = "0px";
          card.style.width = "100vw";
          card.style.height = "100vh";
          card.style.borderRadius = "0px";
          // force a reflow so the transition has a real from-state to animate
          // from (otherwise the browser collapses both writes and it snaps)
          void card.offsetWidth;
          card.classList.add("boot-dock");
          card.style.top = natural.top + "px";
          card.style.left = natural.left + "px";
          card.style.width = natural.width + "px";
          card.style.height = natural.height + "px";
          card.style.borderRadius = "9px";
          var settled = false;
          var land = function () {
            if (settled) return;
            settled = true;
            clearTimeout(dockTimer);
            // strip inside a rAF so the card lands in-flow on the same frame
            // the animated target was reached — no measured end-jump
            requestAnimationFrame(function () {
              stripGeometry();
              // a short beat after the dock fully completes, print the page
              revealTimer = setTimeout(reveal, 120);
            });
          };
          dockEndHandler = function (e) {
            if (e.propertyName !== "width" && e.propertyName !== "height")
              return;
            land();
          };
          card.addEventListener("transitionend", dockEndHandler);
          // safety: land even if transitionend never fires (just past the 1s dock)
          dockTimer = setTimeout(land, 1200);
        };

        var boot = function (instant) {
          if (!html.classList.contains("booting")) return;
          if (instant) {
            html.classList.remove("booting");
            html.classList.add("skip", "booted");
            stripGeometry();
            teardown();
            return;
          }
          if (started) return;
          started = true;
          dock();
        };

        // the typed "source ~/.profile" finishing is the dock trigger
        var onType = function (e) {
          if (
            e.animationName === "type-w" &&
            e.target instanceof Element &&
            e.target.hasAttribute("data-boot-cmd")
          )
            boot(false);
        };

        // any click/keydown during the show jumps to the settled state
        var skip = function () {
          if (html.classList.contains("booting")) {
            boot(true);
          } else {
            html.classList.add("skip");
            teardown();
          }
        };

        document.addEventListener("animationend", onType);
        document.addEventListener("keydown", skip, true);
        document.addEventListener("pointerdown", skip, true);
        if (document.readyState === "loading")
          document.addEventListener("DOMContentLoaded", fullscreen, {
            once: true,
          });
        else fullscreen();
        // safety net: never strand the visitor on a blank page
        fallback = setTimeout(function () {
          boot(true);
        }, 7000);
      })();
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      const root = document.body;
      const toggle = document.querySelector("[data-lang-toggle]");
      const setLanguage = (lang) => {
        root.dataset.lang = lang;
        document.documentElement.lang = lang === "zh" ? "zh-CN" : "en";
        toggle?.setAttribute("aria-pressed", lang === "zh" ? "true" : "false");
        window.localStorage.setItem("site-lang", lang);
      };

      const saved = window.localStorage.getItem("site-lang");
      const initial = saved || (navigator.language?.toLowerCase().startsWith("zh") ? "zh" : "en");
      setLanguage(initial);

      toggle?.addEventListener("click", () => {
        setLanguage(root.dataset.lang === "zh" ? "en" : "zh");
      });
    </script>
  </body>
</html>
