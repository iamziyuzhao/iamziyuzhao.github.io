---
import Base from "../../layouts/Base.astro";

interface PostModule {
  url: string;
  rawContent?: () => string;
  frontmatter: {
    title: string;
    titleZh?: string;
    description?: string;
    descriptionZh?: string;
    category?: string;
    categoryZh?: string;
    date?: string;
  };
}

// Files starting with "_" (e.g. _post-template.md) are not routed by Astro
// and are excluded here too.
const posts = (Object.values(import.meta.glob("./[!_]*.md", { eager: true })) as PostModule[]).sort(
  (a, b) => new Date(b.frontmatter.date ?? 0).valueOf() - new Date(a.frontmatter.date ?? 0).valueOf(),
);

const isoDate = (d?: string) => (d ? new Date(d).toISOString().slice(0, 10) : "");
const readMinutes = (post: PostModule) => {
  const words = typeof post.rawContent === "function" ? post.rawContent().trim().split(/\s+/).length : 0;
  return words ? Math.max(1, Math.round(words / 200)) : null;
};
---

<Base title="Blog | Albert Zhao">
  <section class="prose blog-head">
    <div class="term-path" aria-hidden="true"><span class="tp-cmd">$ ls&nbsp;</span>~/blog/</div>
    <h1><span class="lang-en">Blog</span><span class="lang-zh">博客</span></h1>
    <p class="muted">
      <span class="lang-en">A place for research notes, paper reading, implementation logs, and longer reflections on systems for AI.</span>
      <span class="lang-zh">用于记录研究笔记、论文阅读、实现日志，以及对 AI 系统的长篇思考。</span>
    </p>
  </section>

  <section class="section ls-section">
    <div class="ls-total" aria-hidden="true">total {posts.length}</div>
    <ul class="ls-list">
      {posts.map((post) => {
        const mins = readMinutes(post);
        return (
          <li>
            <div class="ls-row">
              <time class="ls-date" datetime={isoDate(post.frontmatter.date)}>{isoDate(post.frontmatter.date)}</time>
              {(post.frontmatter.category || post.frontmatter.categoryZh) && (
                <span class="ls-cat">
                  <span class="lang-en">{post.frontmatter.category}</span>
                  <span class="lang-zh">{post.frontmatter.categoryZh ?? post.frontmatter.category}</span>
                </span>
              )}
              <a class="ls-title" href={`${post.url}/`}>
                {post.frontmatter.titleZh ? (
                  <>
                    <span class="lang-en">{post.frontmatter.title}</span>
                    <span class="lang-zh">{post.frontmatter.titleZh}</span>
                  </>
                ) : (
                  post.frontmatter.title
                )}
              </a>
              {mins && (
                <span class="ls-read">
                  <span class="lang-en">{mins} min</span>
                  <span class="lang-zh">{mins} 分钟</span>
                </span>
              )}
            </div>
            {(post.frontmatter.description || post.frontmatter.descriptionZh) && (
              <p class="code-comment">
                <span class="lang-en">{post.frontmatter.description}</span>
                <span class="lang-zh">{post.frontmatter.descriptionZh ?? post.frontmatter.description}</span>
              </p>
            )}
          </li>
        );
      })}
    </ul>
  </section>
</Base>
