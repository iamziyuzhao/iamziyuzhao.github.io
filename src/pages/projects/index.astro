---
import Base from "../../layouts/Base.astro";
import LogoMark from "../../components/LogoMark.astro";
import { projects } from "../../data/profile";
---

<Base title="Projects | Albert Zhao">
  <section class="prose">
    <div class="eyebrow"><span class="lang-en">Research & Engineering</span><span class="lang-zh">研究与工程</span></div>
    <h1><span class="lang-en">Projects</span><span class="lang-zh">项目</span></h1>
    <p class="muted">
      <span class="lang-en">Selected systems and infrastructure work around LLM inference, agent runtimes, GPU kernels, and applied AI products.</span>
      <span class="lang-zh">围绕 LLM 推理、agent runtimes、GPU kernels 与应用 AI 产品的系统与基础设施工作。</span>
    </p>
  </section>

  <section class="section">
    <div class="list">
      {projects.map((project) => (
        <article class="item">
          <div class="affiliation-row">
            <LogoMark item={project} />
            <div>
              <h2>{project.title}</h2>
              <div class="meta">
                <span class="lang-en">{project.venue}</span>
                <span class="lang-zh">{project.venueZh}</span>
              </div>
              <p>
                <span class="lang-en">{project.summary}</span>
                <span class="lang-zh">{project.summaryZh}</span>
              </p>
              {project.links.length > 0 && (
                <div class="links">
                  {project.links.map((link) => <a href={link.href}>{link.label}</a>)}
                </div>
              )}
            </div>
          </div>
          <time>{project.date}</time>
        </article>
      ))}
    </div>
  </section>
</Base>
