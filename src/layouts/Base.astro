---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  /** Markdown pages using `layout:` pass their metadata here instead of as direct props. */
  frontmatter?: { title?: string; description?: string };
}

const { frontmatter } = Astro.props;
const title = Astro.props.title ?? frontmatter?.title ?? "Albert (Ziyu) Zhao";
const description =
  Astro.props.description ??
  frontmatter?.description ??
  "Academic personal website of Albert (Ziyu) Zhao.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Crimson+Pro:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      // boot sequence — home page only, motion permitting. Runs before first
      // paint so the rest of the page never flashes. Without JS this script
      // never runs, no class is added, and the site renders normally.
      (function () {
        if (
          location.pathname !== "/" ||
          matchMedia("(prefers-reduced-motion: reduce)").matches
        )
          return;
        var html = document.documentElement;
        html.classList.add("booting");
        var card = null;
        var settleTimer = 0;
        var glideTimer = 0;
        var revealTimer = 0;
        var fallback = 0;
        var started = false;
        var teardown = function () {
          document.removeEventListener("animationend", onType);
          document.removeEventListener("keydown", skip, true);
          document.removeEventListener("pointerdown", skip, true);
          clearTimeout(fallback);
          clearTimeout(settleTimer);
          clearTimeout(glideTimer);
          clearTimeout(revealTimer);
          // leave the card exactly as it renders without the boot show:
          // no transform, no transition, default shadow
          if (card) {
            card.classList.remove("boot-centered", "boot-glide");
            card.style.removeProperty("--boot-dx");
            card.style.removeProperty("--boot-dy");
          }
        };
        // FLIP centering: once the DOM is measurable, compute the offset from
        // the card's natural rect to the viewport center (clamped so a tall
        // card never slides off-screen) and apply it as a pure transform. The
        // card stays invisible under html.booting until .boot-centered lands,
        // so it never flashes at its natural position.
        var center = function () {
          card = document.querySelector(".terminal-hero .term-window");
          if (!card || !html.classList.contains("booting")) return;
          var r = card.getBoundingClientRect();
          var dx = Math.max(16, (innerWidth - r.width) / 2) - r.left;
          var dy = Math.max(16, (innerHeight - r.height) / 2) - r.top;
          card.style.setProperty("--boot-dx", dx.toFixed(2) + "px");
          card.style.setProperty("--boot-dy", dy.toFixed(2) + "px");
          card.classList.add("boot-centered");
        };
        var reveal = function () {
          html.classList.remove("booting");
          html.classList.add("booted");
          // natural reveal settles in <1.2s; then stop listening entirely
          settleTimer = setTimeout(teardown, 1300);
        };
        var boot = function (instant) {
          if (!html.classList.contains("booting")) return;
          if (instant) {
            html.classList.remove("booting");
            html.classList.add("skip", "booted");
            teardown();
            return;
          }
          if (started) return;
          started = true;
          // a beat, then the card glides home; the content cascade starts
          // partway through the glide so the page materializes around it
          glideTimer = setTimeout(function () {
            if (card) {
              card.classList.add("boot-glide");
              card.classList.remove("boot-centered");
            }
            revealTimer = setTimeout(reveal, 270);
          }, 150);
        };
        // the typed "source ~/.profile" finishing is the reveal trigger
        var onType = function (e) {
          if (
            e.animationName === "type-w" &&
            e.target instanceof Element &&
            e.target.hasAttribute("data-boot-cmd")
          )
            boot(false);
        };
        // any click/keydown during the show jumps to the settled state
        var skip = function () {
          if (html.classList.contains("booting")) {
            boot(true);
          } else {
            html.classList.add("skip");
            teardown();
          }
        };
        document.addEventListener("animationend", onType);
        document.addEventListener("keydown", skip, true);
        document.addEventListener("pointerdown", skip, true);
        if (document.readyState === "loading")
          document.addEventListener("DOMContentLoaded", center, { once: true });
        else center();
        // safety net: never strand the visitor on a blank page
        fallback = setTimeout(function () {
          boot(true);
        }, 5000);
      })();
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      const root = document.body;
      const toggle = document.querySelector("[data-lang-toggle]");
      const setLanguage = (lang) => {
        root.dataset.lang = lang;
        document.documentElement.lang = lang === "zh" ? "zh-CN" : "en";
        toggle?.setAttribute("aria-pressed", lang === "zh" ? "true" : "false");
        window.localStorage.setItem("site-lang", lang);
      };

      const saved = window.localStorage.getItem("site-lang");
      const initial = saved || (navigator.language?.toLowerCase().startsWith("zh") ? "zh" : "en");
      setLanguage(initial);

      toggle?.addEventListener("click", () => {
        setLanguage(root.dataset.lang === "zh" ? "en" : "zh");
      });
    </script>
  </body>
</html>
