---
import Base from "../layouts/Base.astro";
import LogoMark from "../components/LogoMark.astro";
import { education, experience, profile, projects } from "../data/profile";
import { formatDate } from "../data/format";
import { posts } from "../data/posts";

const latestPosts = posts.slice(0, 3);
---

<Base
  title="Ziyu Zhao (Albert)"
  description="Ziyu (Albert) Zhao — M.S. student at Carnegie Mellon University researching recursive self-improvement, continual learning, and post-training."
  nav={false}
>
  <header class="profile">
    <div class="profile-info">
      <h1>{profile.name} <span class="nickname">({profile.nickname})</span></h1>
      <p>
        I am a first-year M.S. student in Information Networking at Carnegie Mellon University, concentrating on Machine Learning and AI Infrastructure. I work with <a href="https://tqchen.com/" target="_blank" rel="noreferrer">Prof. Tianqi Chen</a> in the <a href="https://catalyst.cs.cmu.edu/" target="_blank" rel="noreferrer">Catalyst Group</a> on agents and kernels, and with <a href="https://www.andrew.cmu.edu/user/beidic/" target="_blank" rel="noreferrer">Prof. Beidi Chen</a> in the <a href="https://www.infini-ai-lab.cmu.edu/" target="_blank" rel="noreferrer">InfiniAI Lab</a> on recursive self-improvement and continual learning. My research explores how to expand agent capabilities and build efficient agent training systems.
      </p>
      <p>
        Previously, I was a research engineer focused on post-training infrastructure at Tencent Hunyuan, where I worked on scaling long-horizon agentic capabilities for the <a href="https://hy.tencent.ai/research/hy3" target="_blank" rel="noreferrer">Hy3 model</a> across coding, browser DOM, shell and filesystem, OS and GUI, and hardware I/O environments. Motivated by the challenge of policy staleness in agentic reinforcement learning, I joined the <a href="https://www.csl.cornell.edu/faculty/" target="_blank" rel="noreferrer">Computer Systems Lab</a> at Cornell University, where I worked with <a href="https://www.mohsaied.com/" target="_blank" rel="noreferrer">Prof. Mohamed S. Abdelfattah</a> on efficient quantized LLM inference to accelerate rollout generation.
      </p>
      <p>
        During my undergraduate studies at the University of Rochester, I was glad to work with the Google Cloud team that built search and API infrastructure at <a href="https://www.haystackteam.com/key-features/universal-search" target="_blank" rel="noreferrer">Haystack</a>. Inspired by the power of search and recommendation algorithms, several colleagues and I founded the AI company GetMyHome.ai (now <a href="https://www.realkey.ai/" target="_blank" rel="noreferrer">RealKey</a>), where we raised $1.5 million in a pre-seed round.
      </p>
      <nav class="social-links" aria-label="Profile links">
        {profile.email && <a href={`mailto:${profile.email}`}>Email</a>}
        {profile.links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </div>
    <div class="profile-photo">
      <img src={profile.photo} alt="Ziyu (Albert) Zhao" width="1280" height="960" />
    </div>
  </header>

  <section>
    <h2 class="section-heading">Education</h2>
    <div class="entries">
      {education.map((item) => (
        <div class="entry">
          <LogoMark logos={item.logos} />
          <div class="entry-body">
            <div class="entry-name">{item.school}</div>
            <div class="entry-date">{item.date}</div>
            <div class="entry-role">{item.degree}</div>
            {item.note && <div class="entry-detail">{item.note}</div>}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section>
    <h2 class="section-heading">Experience</h2>
    <div class="entries">
      {experience.map((item) => (
        <div class="entry">
          <LogoMark logos={item.logos} href={item.href} />
          <div class="entry-body">
            <div class="entry-name">{item.org}</div>
            <div class="entry-date">{item.date}</div>
            <div class="entry-role">{item.role}</div>
            <div class="entry-detail">{item.detail}</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section>
    <h2 class="section-heading">Projects</h2>
    <div class="entries">
      {projects.map((item) => (
        <div class="entry">
          <LogoMark logos={item.logos} />
          <div class="entry-body">
            <div class="entry-name">
              {item.href ? <a href={item.href} target="_blank" rel="noreferrer">{item.title}</a> : item.title}
            </div>
            <div class="entry-date">{item.venue} · {item.date}</div>
            <div class="entry-detail">{item.summary}</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section>
    <h2 class="section-heading">Blog</h2>
    <div class="post-list">
      {latestPosts.map((post) => (
        <article class="post-item">
          <a class="post-title" href={`${post.url}/`}>{post.title}</a>
          <div class="post-date">{formatDate(post.date)}</div>
          {post.description && <p class="post-desc">{post.description}</p>}
        </article>
      ))}
    </div>
    {posts.length > latestPosts.length && <p class="more-link"><a href="/blog/">All posts →</a></p>}
  </section>
</Base>
