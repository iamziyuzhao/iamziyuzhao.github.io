---
import type { Logo } from "../data/profile";

interface Props {
  logo: Logo;
  /** Organization name — the image's alt text (empty when a link next to it already names it). */
  name: string;
}

const { logo, name } = Astro.props;
---

<div class:list={["entry-logo", { wide: logo.wide }]}>
  {logo.href ? (
    <a href={logo.href} target="_blank" rel="noreferrer">
      <img src={logo.src} alt={name} loading="lazy" />
    </a>
  ) : (
    <img src={logo.src} alt={name} loading="lazy" />
  )}
</div>
