---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Academic personal website of Albert (Ziyu) Zhao." } = Astro.props;
const nav = [
  { href: "/", label: "Home", labelZh: "首页" },
  { href: "/projects/", label: "Research", labelZh: "研究" },
  { href: "/writing/", label: "Writing", labelZh: "写作" },
  { href: "/blog/", label: "Blog", labelZh: "博客" },
  { href: "/cv/", label: "CV", labelZh: "简历" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Crimson+Pro:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <style is:global>
      :root {
        color-scheme: light;
        --bg: #ffffff;
        --paper: #ffffff;
        --ink: #1f1f1f;
        --muted: #585858;
        --faint: #8a8f96;
        --line: #ead7d7;
        --line-strong: #d7b4b4;
        --nav: #b31b1b;
        --accent: #b31b1b;
        --accent-dark: #8a1010;
        --accent-soft: #fff5f5;
        --gold: #9d6b28;
        --green: #2e6f57;
        --amber: #996515;
        --shadow: 0 1px 2px rgba(139, 16, 16, 0.08);
        --radius: 4px;
        --max: 1088px;
        --font-sans: "Open Sans", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans SC", sans-serif;
        --font-mono: "IBM Plex Mono", "SFMono-Regular", Consolas, "Liberation Mono", monospace;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        background:
          linear-gradient(180deg, var(--accent-soft) 0, #ffffff 240px),
          var(--bg);
        color: var(--ink);
        font-family: var(--font-sans);
        font-size: 16px;
        line-height: 1.52;
      }

      a {
        color: var(--accent);
        text-decoration-thickness: 1px;
        text-underline-offset: 3px;
      }

      a:hover { color: var(--accent-dark); }

      a:focus-visible,
      button:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
      }

      .site-header {
        background: var(--nav);
        border-bottom: 5px solid #8a1010;
        position: sticky;
        top: 0;
        z-index: 10;
        box-shadow: 0 1px 3px rgba(139, 16, 16, 0.12);
      }

      .nav {
        max-width: var(--max);
        margin: 0 auto;
        min-height: 54px;
        padding: 0 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .brand {
        color: #ffffff;
        font-size: 21px;
        font-weight: 700;
        text-decoration: none;
      }

      .nav-links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-end;
        gap: 20px;
      }

      .nav-links a {
        color: rgba(255, 255, 255, 0.9);
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
      }

      .nav-links a:hover { color: #ffffff; }

      .lang-toggle {
        min-width: 58px;
        border: 1px solid rgba(255, 255, 255, 0.55);
        border-radius: var(--radius);
        background: #ffffff;
        color: var(--accent-dark);
        cursor: pointer;
        font: inherit;
        font-size: 13px;
        line-height: 1;
        padding: 6px 10px;
      }

      .lang-toggle:hover { background: #ffffff; }

      .lang-zh { display: none; }
      body[data-lang="zh"] .lang-en { display: none; }
      body[data-lang="zh"] .lang-zh { display: inline; }
      body[data-lang="zh"] p.lang-zh,
      body[data-lang="zh"] div.lang-zh,
      body[data-lang="zh"] span.lang-zh.block { display: block; }

      main {
        max-width: var(--max);
        margin: 0 auto;
        padding: 26px 18px 64px;
      }

      h1, h2, h3 {
        margin: 0;
        line-height: 1.2;
        font-weight: 700;
      }

      h1 {
        font-size: 31px;
        margin-bottom: 14px;
      }

      h2 {
        color: var(--accent-dark);
        font-size: 15px;
        letter-spacing: 0.02em;
        margin-bottom: 16px;
        text-transform: uppercase;
      }

      h3 { font-size: 16px; }

      p { margin: 0 0 14px; }
      .muted { color: var(--muted); }
      .small { font-size: 13px; }

      .academic-shell {
        display: grid;
        grid-template-columns: 286px minmax(0, 1fr);
        gap: 18px;
        align-items: start;
      }

      .academic-main {
        grid-column: 2;
        grid-row: 1;
      }

      .profile-card {
        grid-column: 1;
        grid-row: 1;
        position: sticky;
        top: 84px;
        background: var(--paper);
        border-radius: var(--radius);
        border: 1px solid var(--line);
        border-top: 5px solid var(--accent);
        box-shadow: var(--shadow);
        padding: 22px 16px;
        text-align: center;
      }

      .portrait {
        display: block;
        width: 207px;
        max-width: 100%;
        height: 208px;
        margin: 0 auto 16px;
        object-fit: cover;
        object-position: center 38%;
        border-radius: 3px;
        background: var(--line);
      }

      .profile-name {
        font-size: 25px;
        font-weight: 700;
        line-height: 1.15;
        margin-bottom: 6px;
      }

      .profile-title {
        color: var(--muted);
        font-size: 14px;
        line-height: 1.4;
      }

      .profile-detail {
        color: var(--muted);
        font-size: 14px;
        line-height: 1.5;
        margin-top: 14px;
      }

      .profile-links {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 8px 12px;
        margin-top: 14px;
        font-size: 14px;
      }

      .profile-note {
        margin: 16px 0 0;
        padding-top: 14px;
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-size: 13px;
        line-height: 1.45;
      }

      .content-card,
      .hero-statement {
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 24px 22px;
        margin-bottom: 18px;
      }

      .hero-statement {
        background: linear-gradient(90deg, #ffffff 0, #ffffff 70%, var(--accent-soft) 100%);
        border-top: 5px solid var(--accent);
      }

      .hero-statement p {
        max-width: 770px;
      }

      .cv-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 20px 34px;
      }

      .cv-block h2 {
        font-size: 16px;
        margin-bottom: 10px;
      }

      .cv-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 14px;
      }

      .cv-list li {
        color: var(--muted);
        font-size: 14px;
        line-height: 1.45;
      }

      .cv-list .affiliation-row {
        align-items: flex-start;
      }

      .cv-list strong {
        display: block;
        color: var(--ink);
        font-weight: 600;
      }

      .section-heading {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 16px;
      }

      .section-heading h2 { margin-bottom: 0; }
      .section-heading a {
        font-size: 13px;
        white-space: nowrap;
      }

      .eyebrow {
        color: var(--accent-dark);
        font-family: var(--font-mono);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0;
        margin-bottom: 8px;
        text-transform: uppercase;
      }

      .paper-list {
        display: grid;
      }

      .paper-row {
        display: grid;
        grid-template-columns: 136px minmax(0, 1fr);
        gap: 18px;
        padding: 20px 0;
        border-top: 1px solid var(--line);
      }

      .paper-row:first-child {
        border-top: 0;
        padding-top: 0;
      }

      .paper-year {
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: 13px;
        line-height: 1.45;
      }

      .affiliation-row {
        display: grid;
        grid-template-columns: max-content minmax(0, 1fr);
        gap: 14px;
        align-items: center;
      }

      .brand {
        font-size: 18px;
      }

      .nav-links a {
        font-size: 16px;
      }

      .lang-toggle {
        font-size: 15px;
      }

      .logo-mark {
        width: 46px;
        min-height: 46px;
        display: inline-flex;
        align-items: center;
      }

      .logo-mark.logo-pair {
        width: auto;
        gap: 6px;
      }

      .logo-box {
        width: 46px;
        height: 46px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 3px;
        overflow: hidden;
      }

      .logo-box img {
        display: block;
        max-width: 38px;
        max-height: 38px;
        object-fit: contain;
      }

      .logo-box a {
        color: inherit;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
        text-decoration: none;
      }

      .logo-box.wide img {
        max-width: 58px;
        max-height: 28px;
      }

      .logo-box.wide {
        width: 64px;
      }

      .logo-box.text-logo {
        background: var(--accent-soft);
        color: var(--accent-dark);
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0;
      }

      .logo-box.text-logo span {
        max-width: 100%;
        overflow: hidden;
        padding: 0 3px;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .paper-title {
        font-size: 18px;
        font-weight: 600;
        line-height: 1.3;
        margin-bottom: 4px;
      }

      .paper-meta {
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: 14px;
        line-height: 1.45;
        margin-bottom: 7px;
      }

      .badge-row {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin: 0 0 8px;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        background: var(--accent);
        color: #ffffff;
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 700;
        line-height: 1;
        padding: 4px 7px;
      }

      .badge.green {
        background: #ffffff;
        border: 1px solid var(--accent);
        color: var(--accent-dark);
      }

      .badge.amber {
        background: #ffffff;
        border: 1px solid var(--gold);
        color: #704a16;
      }

      .links {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 8px;
        font-size: 14px;
      }

      .news-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 9px;
      }

      .news-list li {
        display: grid;
        grid-template-columns: 64px minmax(0, 1fr);
        gap: 14px;
        color: var(--ink);
        font-size: 14px;
      }

      .news-list time {
        color: var(--muted);
        font-family: var(--font-mono);
      }

      .prose {
        max-width: 760px;
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 24px 15px;
      }

      .prose h1 { font-size: 34px; }
      .prose h2 { margin-top: 28px; }
      .prose ul { padding-left: 22px; }

      .section {
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 24px 15px;
        margin-top: 16px;
      }

      .list {
        display: grid;
        gap: 18px;
      }

      .item {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 130px;
        gap: 16px;
        padding-top: 18px;
        border-top: 1px solid var(--line);
      }

      .item:first-child {
        border-top: 0;
        padding-top: 0;
      }

      .item time {
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: 13px;
        text-align: right;
      }

      .item h2 {
        color: var(--ink);
        font-size: 18px;
        letter-spacing: 0;
        margin-bottom: 4px;
        text-transform: none;
      }

      .item-title {
        font-size: 18px;
        font-weight: 600;
      }

      .meta {
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: 14px;
        line-height: 1.45;
      }

      .footer {
        max-width: var(--max);
        margin: 0 auto;
        padding: 24px 15px 38px;
        color: var(--muted);
        font-size: 13px;
      }

      @media (max-width: 760px) {
        body { font-size: 15px; }

        .nav {
          align-items: flex-start;
          flex-direction: column;
          min-height: auto;
          gap: 10px;
          padding: 12px 15px;
        }

        .nav-links {
          justify-content: flex-start;
          gap: 8px 11px;
        }

        .nav-links a {
          font-size: 13px;
        }

        .lang-toggle {
          min-width: 52px;
          padding: 5px 8px;
        }

        main { padding-top: 16px; }

        .academic-shell {
          grid-template-columns: 1fr;
          gap: 16px;
        }

        .academic-main,
        .profile-card {
          grid-column: auto;
          grid-row: auto;
        }

        .profile-card {
          position: static;
          order: -1;
        }

        .portrait {
          width: 100%;
          height: auto;
          aspect-ratio: 16 / 8;
        }

        .cv-grid,
        .paper-row,
        .news-list li,
        .item {
          grid-template-columns: 1fr;
        }

        .paper-row { gap: 5px; }
        .affiliation-row {
          grid-template-columns: max-content minmax(0, 1fr);
          gap: 10px;
        }

        .affiliation-row:has(.logo-pair) {
          grid-template-columns: 1fr;
          gap: 8px;
        }

        .affiliation-row:has(.logo-pair) .logo-mark {
          width: max-content;
        }

        .logo-mark {
          width: 40px;
          min-height: 40px;
        }

        .logo-mark.logo-pair {
          width: auto;
        }

        .logo-box {
          width: 40px;
          height: 40px;
        }

        .logo-box img {
          max-width: 34px;
          max-height: 34px;
        }

        .logo-box.wide img {
          max-width: 48px;
          max-height: 24px;
        }

        .logo-box.wide {
          width: 54px;
        }

        .item time { text-align: left; }
        .section-heading { align-items: flex-start; }
      }
    </style>
    <style is:global>
      :root {
        --bg: #ffffff;
        --paper: #ffffff;
        --ink: #2d3436;
        --muted: #5f6b73;
        --faint: #83909a;
        --line: #e7eaee;
        --line-strong: #cfd7df;
        --nav: #ffffff;
        --accent: #2563a8;
        --accent-dark: #174778;
        --accent-soft: #edf5ff;
        --shadow: none;
        --radius: 10px;
        --max: 980px;
        --font-sans: "Atkinson Hyperlegible", Lato, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans SC", sans-serif;
        --font-serif: "Atkinson Hyperlegible", Lato, ui-sans-serif, system-ui, sans-serif;
      }

      body {
        background: #fff;
        color: var(--ink);
        font-size: 16px;
        line-height: 1.68;
      }

      .site-header {
        position: static;
        background: transparent;
        border: 0;
        backdrop-filter: none;
      }

      .nav {
        max-width: var(--max);
        min-height: 72px;
        padding: 0 24px;
      }

      .brand {
        color: var(--ink);
        font-family: var(--font-sans);
        font-size: 16px;
        font-weight: 700;
      }

      .nav-links {
        gap: 14px;
      }

      .nav-links a {
        color: var(--muted);
        font-family: var(--font-sans);
        font-size: 14px;
        font-weight: 700;
        text-transform: none;
      }

      .nav-links a:hover {
        color: var(--accent);
      }

      .lang-toggle {
        min-height: 30px;
        border: 1px solid var(--line);
        background: #fff;
        color: var(--muted);
      }

      .lang-toggle:hover {
        background: #f7fafc;
      }

      main {
        max-width: var(--max);
        padding: 34px 24px 84px;
      }

      h1 {
        font-family: var(--font-sans);
        font-size: clamp(40px, 6vw, 58px);
        font-weight: 700;
        line-height: 1.04;
        margin-bottom: 18px;
      }

      h2,
      .eyebrow {
        color: var(--ink);
        font-family: var(--font-sans);
        font-size: 28px;
        font-weight: 700;
        text-transform: none;
      }

      .eyebrow {
        position: relative;
        display: inline-block;
        margin-bottom: 20px;
        padding-bottom: 8px;
      }

      .eyebrow::after {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 42px;
        height: 3px;
        background: var(--accent);
        border-radius: 999px;
        content: "";
      }

      .academic-shell {
        grid-template-columns: minmax(0, 1fr) 224px;
        gap: 54px;
        align-items: start;
      }

      .academic-main {
        grid-column: 1;
      }

      .profile-card {
        grid-column: 2;
        position: static;
        border: 0;
        background: transparent;
        box-shadow: none;
        padding: 6px 0 0;
        text-align: left;
      }

      .portrait {
        width: 186px;
        height: 186px;
        margin: 0 0 22px auto;
        border: 1px solid var(--line);
        border-radius: 999px;
        object-position: center 38%;
      }

      .profile-name {
        display: none;
      }

      .profile-title,
      .profile-detail,
      .profile-note {
        color: var(--muted);
        font-size: 14px;
      }

      .profile-links {
        justify-content: flex-start;
        gap: 8px;
        margin-top: 16px;
      }

      .profile-links a,
      .links a {
        min-height: 32px;
        border-radius: 999px;
        padding: 5px 12px;
        font-family: var(--font-sans);
        font-size: 13px;
        font-weight: 700;
      }

      .profile-facts {
        gap: 7px;
      }

      .profile-facts span,
      .badge {
        border-radius: 999px;
        font-family: var(--font-sans);
        font-size: 12px;
      }

      .hero-statement,
      .content-card,
      .prose,
      .section {
        border: 0;
        background: transparent;
        box-shadow: none;
        padding: 0;
      }

      .hero-statement {
        display: block;
        margin: 0 0 76px;
      }

      .hero-statement .eyebrow {
        display: none;
      }

      .hero-statement p {
        max-width: 650px;
        color: var(--muted);
        font-size: 18px;
        line-height: 1.68;
      }

      .fact-strip {
        max-width: 650px;
        margin-top: 24px;
      }

      .fact-strip span {
        border-top-color: var(--line);
      }

      .content-card,
      .section {
        margin: 0 0 72px;
      }

      .section-heading {
        display: block;
        border: 0;
        margin-bottom: 18px;
        padding: 0;
      }

      .section-heading h2 {
        position: relative;
        display: inline-block;
        margin-bottom: 10px;
        padding-bottom: 8px;
      }

      .section-heading h2::after,
      .section > h2::after {
        display: block;
        width: 42px;
        height: 3px;
        margin-top: 8px;
        background: var(--accent);
        border-radius: 999px;
        content: "";
      }

      .section-heading a {
        display: inline-block;
        margin-left: 14px;
        font-size: 14px;
      }

      .cv-grid {
        grid-template-columns: 1fr;
        gap: 46px;
      }

      .cv-block h2 {
        font-size: 24px;
      }

      .cv-list {
        gap: 18px;
      }

      .cv-list li {
        font-size: 15px;
      }

      .paper-row {
        grid-template-columns: 96px minmax(0, 1fr);
        gap: 22px;
        padding: 24px 0;
        border-top: 1px solid var(--line);
      }

      .paper-row:first-child {
        border-top: 0;
      }

      .paper-title,
      .item-title,
      .item h2 {
        font-family: var(--font-sans);
        font-size: 21px;
        line-height: 1.28;
      }

      .paper-meta,
      .meta {
        font-family: var(--font-sans);
        font-size: 14px;
      }

      .paper-year,
      .item time,
      .news-list time {
        font-family: var(--font-sans);
        font-size: 13px;
      }

      .logo-box {
        border-radius: 8px;
      }

      .news-list li {
        grid-template-columns: 60px minmax(0, 1fr);
        font-size: 15px;
      }

      .prose {
        margin-bottom: 56px;
      }

      .prose h1 {
        font-size: clamp(36px, 5vw, 52px);
      }

      .item {
        grid-template-columns: minmax(0, 1fr) 120px;
        padding: 24px 0;
      }

      .footer {
        max-width: var(--max);
        color: var(--faint);
      }

      @media (max-width: 760px) {
