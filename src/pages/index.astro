---
import Base from "../layouts/Base.astro";
import LogoMark from "../components/LogoMark.astro";
import { education, experience, profile, projects } from "../data/profile";
import { formatDate } from "../data/format";
import { posts } from "../data/posts";

const latestPosts = posts.slice(0, 3);
---

<Base
  title="Ziyu Zhao (Albert)"
  description="Ziyu (Albert) Zhao — M.S. student at Carnegie Mellon University researching recursive self-improvement, continual learning, and post-training."
  nav={false}
>
  <header class="profile">
    <div class="profile-info">
      <h1>{profile.name} <span class="nickname">({profile.nickname})</span></h1>
      <p>
        I'm a first-year M.S. student at Carnegie Mellon University, advised by <a href="https://tqchen.com/" target="_blank" rel="noreferrer">Prof. Tianqi Chen</a> and <a href="https://www.andrew.cmu.edu/user/beidic/" target="_blank" rel="noreferrer">Prof. Beidi Chen</a>. I work on RL post-training and efficient inference, and will join ByteDance as a Research Scientist Intern on post-training.
      </p>
      <p>
        I came to efficient inference through RL. While building post-training infrastructure for the <a href="https://hy.tencent.ai/research/hy3" target="_blank" rel="noreferrer">Hy3 model</a> at Tencent Hunyuan, I saw how much stale rollouts slow RL down, and making inference faster became the problem I wanted to solve. Since then, I've worked on LLM quantization with <a href="https://www.mohsaied.com/" target="_blank" rel="noreferrer">Prof. Mohamed S. Abdelfattah</a> at Cornell and on GPU kernels at CMU.
      </p>
      <p>
        Before that, I studied Computer Science and Business at the University of Rochester, built search infrastructure at <a href="https://www.haystackteam.com/key-features/universal-search" target="_blank" rel="noreferrer">Haystack</a>, and was a founding member of GetMyHome.ai (now <a href="https://www.realkey.ai/" target="_blank" rel="noreferrer">RealKey</a>), which raised $1.5M.
      </p>
      <nav class="social-links" aria-label="Profile links">
        {profile.email && <a href={`mailto:${profile.email}`}>Email</a>}
        {profile.links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </div>
    <div class="profile-photo">
      <img src={profile.photo} alt="Ziyu (Albert) Zhao" width="1280" height="960" />
    </div>
  </header>

  <section>
    <h2 class="section-heading">Education</h2>
    <div class="entries">
      {education.map((item) => (
        <div class="entry">
          <LogoMark logos={item.logos} />
          <div class="entry-body">
            <div class="entry-name">{item.school}</div>
            <div class="entry-date">{item.date}</div>
            <div class="entry-role">{item.degree}</div>
            {item.note && <div class="entry-detail">{item.note}</div>}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section>
    <h2 class="section-heading">Experience</h2>
    <div class="entries">
      {experience.map((item) => (
        <div class="entry">
          <LogoMark logos={item.logos} href={item.href} />
          <div class="entry-body">
            <div class="entry-name">{item.org}</div>
            <div class="entry-date">{item.date}</div>
            <div class="entry-role">{item.role}</div>
            <div class="entry-detail">{item.detail}</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section>
    <h2 class="section-heading">Projects</h2>
    <div class="entries">
      {projects.map((item) => (
        <div class="entry">
          <LogoMark logos={item.logos} />
          <div class="entry-body">
            <div class="entry-name">
              {item.href ? <a href={item.href} target="_blank" rel="noreferrer">{item.title}</a> : item.title}
            </div>
            <div class="entry-date">{item.venue} · {item.date}</div>
            <div class="entry-detail">{item.summary}</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section>
    <h2 class="section-heading">Blog</h2>
    <div class="post-list">
      {latestPosts.map((post) => (
        <article class="post-item">
          <a class="post-title" href={`${post.url}/`}>{post.title}</a>
          <div class="post-date">{formatDate(post.date)}</div>
          {post.description && <p class="post-desc">{post.description}</p>}
        </article>
      ))}
    </div>
    {posts.length > latestPosts.length && <p class="more-link"><a href="/blog/">All posts →</a></p>}
  </section>
</Base>
